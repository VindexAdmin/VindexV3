{
  "manifest_version": 3,
  "name": "Vindex Wallet Extension",
  "version": "1.0.0",
  "description": "A Chrome extension for managing your Vindex cryptocurrency wallet.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "host"
  ],
  "host_permissions": [
    "http://localhost:3001/*",
    "https://*.vindex.io/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["*.js", "*.css", "*.png"],
      "matches": ["<all_urls>"]
    }
  ]
}