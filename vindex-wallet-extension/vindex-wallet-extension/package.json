{
  "name": "vindex-wallet-extension",
  "version": "1.0.0",
  "description": "A Chrome extension for the Vindex cryptocurrency wallet.",
  "main": "dist/background.js",
  "scripts": {
    "build": "webpack --mode production",
    "dev": "webpack --mode development --watch",
    "start": "webpack serve --mode development",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "jest",
    "clean": "rm -rf dist",
    "package": "npm run build && zip -r vindex-wallet-extension.zip dist/ public/"
  },
  "keywords": [
    "chrome",
    "extension",
    "wallet",
    "cryptocurrency",
    "vindex",
    "blockchain"
  ],
  "author": "Vindex Team",
  "license": "MIT",
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "crypto-js": "^4.1.1",
    "bip39": "^3.1.0",
    "ethers": "^6.7.1"
  },
  "devDependencies": {
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@types/chrome": "^0.0.243",
    "@types/crypto-js": "^4.1.1",
    "typescript": "^5.1.6",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1",
    "ts-loader": "^9.4.4",
    "html-webpack-plugin": "^5.5.3",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.8.1",
    "style-loader": "^3.3.3",
    "eslint": "^8.45.0",
    "@typescript-eslint/eslint-plugin": "^6.2.1",
    "@typescript-eslint/parser": "^6.2.1",
    "jest": "^29.6.2"
  }
}